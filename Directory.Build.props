<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup Label="Configuration">
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>

  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgUseStatic>true</VcpkgUseStatic>
    <VcpkgTriplet Condition="'$(Platform)'=='Win32'">x86-windows-static</VcpkgTriplet>
    <VcpkgTriplet Condition="'$(Platform)'=='x64'">x64-windows-static</VcpkgTriplet>
    <VcpkgAutoLink>false</VcpkgAutoLink>
  </PropertyGroup>

  <PropertyGroup>
    <ProjectRootDir>$(MSBuildThisFileDirectory)</ProjectRootDir>
    <!-- Direct all intermediate build garbage to folder Build in project root, separated by Platform and Configuration -->
    <IntDir>$(ProjectRootDir)Build\Intermediate\$(Platform)\$(MSBuildProjectName)\$(Configuration)\</IntDir>
    <!-- Direct static library outputs to Build\Lib in project root, separated by Platform and Configuration -->
    <OutDir Condition="'$(ConfigurationType)'!='Application'">$(ProjectRootDir)Build\Lib\$(Platform)\$(Configuration)\</OutDir>
    <!-- Application output goes to Output\ and Build\, separated by Platform and Configuration -->
    <OutDir Condition="'$(ConfigurationType)'=='Application'">$(ProjectRootDir)Output\$(Platform)\$(Configuration)\</OutDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_SILENCE_STDEXT_HASH_DEPRECATION_WARNINGS;_SILENCE_CXX17_ITERATOR_BASE_CLASS_DEPRECATION_WARNING;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <MinimalRebuild>false</MinimalRebuild>
    </ClCompile>
    <Link>
      <AdditionalDependencies>legacy_stdio_definitions.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(ProjectRootDir)Build\Lib\$(Platform)\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <ImageHasSafeExceptionHandlers>false</ImageHasSafeExceptionHandlers>
    </Link>
  </ItemDefinitionGroup>
</Project>
